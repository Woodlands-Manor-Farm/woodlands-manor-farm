{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woodlands-manor-farm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Non-secret runtime config. Kept here so Cloudflare deploys stay in sync
  // and these values survive every deploy. Secrets (BREVO_API_KEY,
  // GOOGLE_PLACES_API_KEY) are set as encrypted Worker secrets, never here.
  "vars": {
    "BREVO_DOI_TEMPLATE_ID": "5",
    "BREVO_SENDER_EMAIL": "enquiries@woodlandsmanorfarm.co.uk"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
