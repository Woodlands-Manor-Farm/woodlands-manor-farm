# Server-side only. Configure as encrypted Cloudflare Worker secrets in production.
BREVO_API_KEY=
# A Brevo double opt-in email template containing the confirmation link {{ params.DOIurl }}.
BREVO_DOI_TEMPLATE_ID=
# Verified Brevo sender address for website enquiries. Recipient is fixed to the farm inbox.
BREVO_SENDER_EMAIL=enquiries@woodlandsmanorfarm.co.uk

# Google reviews. Keep the API key server-side (a Worker secret in production).
GOOGLE_PLACES_API_KEY=
# Optional local-development fallback when the Google key is only in Cloudflare.
# Requires a deployed version that provides /api/reviews/?view=all.
GOOGLE_REVIEWS_PREVIEW_ORIGIN=https://woodlands-manor-farm.woodlands-manor-farm.workers.dev
